<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartDocQA.Eval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Prompts\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="golden-dataset.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="judges-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Deliberately NOT referencing SmartDocQA.Application/Domain here.
    Reason: the eval harness talks to the API purely over HTTP, the same
    way any external client or CI job would. This keeps the eval decoupled
    from internal refactors (e.g. if QAResult's shape changes internally
    but the API contract stays the same, eval keeps working), and it means
    the harness can eventually run against a deployed instance, not just
    a local build.
  -->

</Project>
