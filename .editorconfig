# .editorconfig — SmartDocQA solution-wide C# style rules.
# Enforced automatically by Visual Studio / Rider / `dotnet format`, so
# style stays consistent across the codebase without relying on manual
# review or memory. Matches the conventions already used throughout the
# project (file-scoped namespaces, 4-space indent, _camelCase private
# fields, Allman brace style).

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# ── Namespaces ──────────────────────────────────────────────────────────
# File-scoped namespaces (namespace Foo;) rather than block-scoped
# (namespace Foo { }) -- matches every file written this project.
csharp_style_namespace_declarations = file_scoped:warning

# ── Braces ──────────────────────────────────────────────────────────────
# Allman style: opening brace on its own new line -- matches every class/
# method in the codebase.
csharp_new_line_before_open_brace = all

# ── var usage ───────────────────────────────────────────────────────────
# Prefer explicit types for clarity, except where the type is obvious
# from the right-hand side (e.g. `var options = new RagOptions();`).
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# ── Naming: private fields use _camelCase ───────────────────────────────
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers = readonly

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# ── Naming: interfaces start with I ──────────────────────────────────────
dotnet_naming_rule.interface_prefix.severity = warning
dotnet_naming_rule.interface_prefix.symbols = interfaces
dotnet_naming_rule.interface_prefix.style = i_prefix

dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_style.i_prefix.capitalization = pascal_case
dotnet_naming_style.i_prefix.required_prefix = I

# ── Usings ────────────────────────────────────────────────────────────
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# ── Expression-bodied members ────────────────────────────────────────────
# Allow but don't force -- matches the mix already used (some one-liner
# methods use =>, most multi-step ones use full bodies).
csharp_style_expression_bodied_methods = when_on_single_line:suggestion

# ── Nullable reference types ─────────────────────────────────────────────
dotnet_diagnostic.CS8618.severity = warning
dotnet_diagnostic.CS8625.severity = warning

# ── Unused usings ─────────────────────────────────────────────────────
dotnet_diagnostic.CS8019.severity = warning

[*.{json,csproj,props,targets}]
indent_size = 2