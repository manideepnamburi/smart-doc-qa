{
  "Anthropic": {
    "ApiKey": "sk-ant-YOUR_CLAUDE_KEY_HERE",
    "ChatModel": "claude-haiku-4-5",
    "VisionModel": "claude-haiku-4-5",
    "MaxTokens": 1500,
    "RetryCount": 3,
    "RetryDelayMs": 1000
  },

  "Embedding": {
    "Provider": "AzureOpenAI",
    "AzureEndpoint": "https://YOUR_RESOURCE_NAME.openai.azure.com/",
    "AzureApiKey": "YOUR_AZURE_KEY_HERE",
    "AzureEmbeddingDeployment": "text-embedding-ada-002",
    "OpenAIApiKey": "",
    "OpenAIEmbeddingModel": "text-embedding-3-small",
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaEmbeddingModel": "all-minilm",
    "VectorSize": 1536
  },

  "Qdrant": {
    "Host": "localhost",
    "Port": 6336,
    "CollectionName": "smart-doc-qa",
    "VectorSize": 1536
  },

  "Neo4j": {
    "Uri": "bolt://localhost:7687",
    "Username": "neo4j",
    "Password": "YOUR_NEO4J_PASSWORD"
  },

  "AzureDocIntelligence": {
    "Endpoint": "SET_IN_appsettings.Development.json",
    "ApiKey": "SET_IN_appsettings.Development.json",
    "Enabled": true
  },

  "AzureBlob": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net",
    "DefaultContainer": "documents"
  },

  "OneDrive": {
    "TenantId": "YOUR_TENANT_ID",
    "ClientId": "YOUR_CLIENT_ID",
    "ClientSecret": "YOUR_CLIENT_SECRET"
  },

  "RAG": {
    "TopKDense": 20,
    "TopKSparse": 20,
    "TopKAfterFusion": 20,
    "TopKAfterRerank": 5,
    "VectorWeight": 0.6,
    "BM25Weight": 0.4,
    "RRF_K": 60,
    "UseGraphRetrieval": true,
    "UseReranking": true,
    "UseHybridIndex": true,
    "UseTableExtraction": true,
    "UseChartExtraction": true,
    "UseQueryRewriting": true,
    "MinSimilarityScore": 0.5
  },

  "Chunking": {
    "Strategy": "FixedSize",
    "TokenSize": 500,
    "Overlap": 50
  },

  "Prompts": {
    "BasePath": "Prompts/",
    "QASystem": "qa_system.txt",
    "QAUser": "qa_user.txt",
    "Rerank": "rerank_system.txt",
    "EntityExtraction": "entity_extraction.txt",
    "QueryRewrite": "query_rewrite.txt"
  },

  "Registry": {
    "DatabasePath": "registry/documents.db"
  },

  "FolderScan": {
    "SupportedExtensions": [ ".pdf", ".docx", ".doc", ".txt" ]
  },

  "BM25": {
    "DatabasePath": "bm25/bm25.db"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SmartDocQA.Infrastructure.Retrieval.BM25KeywordIndex": "Debug"
    }
  },

  "AllowedHosts": "*"
}
