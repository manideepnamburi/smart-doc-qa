<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartDocQA.Infrastructure</RootNamespace>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartDocQA.Domain\SmartDocQA.Domain.csproj" />
    <ProjectReference Include="..\SmartDocQA.Application\SmartDocQA.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Semantic Kernel -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.74.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Qdrant" Version="1.74.0-preview" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.74.0" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />

  

    <!-- PDF + Word -->
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />

    <!-- Azure -->
    <PackageReference Include="Azure.AI.FormRecognizer" Version="4.1.0" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.22.0" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />

    <!-- Graph DB -->
    <PackageReference Include="Neo4j.Driver" Version="6.2.1" />

    <!-- OneDrive -->
    <PackageReference Include="Microsoft.Graph" Version="5.65.0" />

    <!-- Ollama -->
    <PackageReference Include="OllamaSharp" Version="4.0.7" />

    <!-- SQLite — document registry -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />

    <!-- Resilience -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.3.0" />
  </ItemGroup>

</Project>
